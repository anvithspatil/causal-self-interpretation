cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Model/cache files
.cache/
cache/
huggingface/
.huggingface/

# Large model files
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Logs
*.log

# Temporary files
*.tmp
*.temp
EOF